# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# Used by both docker-compose.yml (to create the DB/user) and the Spring Boot
# app (to connect to it). Keep the values identical in both places.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calendarapp
DB_USER=calendarapp_user
DB_PASSWORD=changeme
