# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# Used by both docker-compose.yml (to create the DB/user) and the Spring Boot
# app (to connect to it). Keep the values identical in both places.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calendarapp
DB_USER=calendarapp_user
DB_PASSWORD=changeme

# JWT signing secret. Must be a long, random, high-entropy string
# (at least 32 bytes / 256 bits) — the app refuses to start otherwise.
# Generate one locally, e.g.: openssl rand -base64 48
# NEVER commit a real secret — this is a placeholder only.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES

# How long an issued JWT stays valid, in milliseconds (e.g. 3600000 = 1 hour).
JWT_EXPIRATION_MILLISECONDS=3600000
